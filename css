@font-face { font-family: 'Glacial Indifference'; 
src: url('glacial-indifference.regular.otf') format('opentype'); 
} 
@font-face { font-family: 'inria-serif'; 
src: url('inria-serif.italic.otf') format('opentype'); 
} 
@font-face { font-family: 'alegreya sans sc'; 
src: url('alegreya-sans-sc.regular.ttf') format('opentype'); 
} 

body { 
padding: 0; 
margin: 0; 
font-family: Open Sans, Glacial Indifference, inria-serif, alegreya sans sc, sans-serif; 
} 

/* HEADER */ 
.header { 
display: flex; 
justify-content: space-between; 
align-items: center; 
padding: 20px 20px; 
background: white; 
} 

.left { 
display: flex; 
align-items: center; 
} 

.logo { 
width: 80px; 
margin-right: 20px; 
margin-left: 10px; 
margin-top: -20px; 
margin-bottom: -20px; 
} 

.company { 
font-weight: normal; 
font-size: 20px; 
} 

/* NAV BUTTONS */ 
.nav a { 
margin-left: 20px; 
padding: 10px 25px; 
background: white; 
border-radius: 25px; 
text-decoration: none; 
color: black; 
transition: all 0.3s ease; 
} 

/* HOVER EFFECT */ 
.nav a:hover { 
background: orange; 
color: black; 
transform: translateY(-3px); 
} 

/* HERO */ 
.hero { 
margin: 0; 
position: relative; 
height: 45vh; 
background: center/cover no-repeat; 
background-color: #000000; 
} 

.hero::before { 
content: ''; 
position: absolute; 
inset: 0; 
background: black 
} 

.hero-content { 
position: absolute; 
top: 50%; 
left: 50%; 
transform: translate(-50%, -50%); 
color: white; 
text-align: center; 
width: 80%; 
} 

.hero-content h1 { 
font-size: 80px; 
font-family: 'inria-serif', serif; 
font-style: italic; 
font-weight: 250; 
margin: 0 0 10px; 
letter-spacing: 2px; 
text-transform: uppercase; 
} 

.hero-content p { 
font-size: 15px; 
font-family: 'Glacial Indifference', sans-serif; 
letter-spacing: 2px; 
line-height: 2; 
text-transform: uppercase; 
margin: 0; 
} 

/* MAIN LAYOUT */ 
.main-layout { 
display: flex; 
min-height: 60vh; 
} 

/* SIDEBAR */ 
.sidebar { 
width: 250px; 
min-width: 250px; 
padding: 20px 15px; 
border-right: 1px solid #ddd; 
background: white; 
} 

.search-bar { 
display: flex; 
align-items: center; 
margin-bottom: 20px; 
border: 2px solid orange; 
border-radius: 20px; 
overflow: hidden; 
padding: 5px 8px; 
gap: 8px;
width: 100%;
box-sizing: border-box;
} 

.search-bar input { 
border: none; 
outline: none; 
font-size: 13px; 
background: transparent;  
flex: 1;
min-width: 0; 
} 

.search-bar button { 
background: orange; 
border: none; 
border-radius: 50%; 
width: 28px; 
height: 28px; 
cursor: pointer; 
color: white; 
font-size: 14px; 
flex-shrink: 0;
} 

/* SIDEBAR LIST */ 

.sidebar ul { 
list-style: none; 
padding: 0; 
margin: 0; 
} 

.sidebar ul li { 
padding: 2px 0; 
line-height: 1.2;
font-family: 'Saira Stencil One', sans-serif; 
font-size: 15px; 
color: #000000; 
display: flex; 
align-items: center; 
cursor: pointer; 
} 

.sidebar ul li span:hover { 
text-decoration-line: underline; 
text-decoration-color: orange; 
text-decoration-thickness: 2px; 
text-underline-offset: 6px; 
cursor: pointer; 
} 

/* GEAR ICON */ 
.sidebar ul li::before { 
content: '⚙'; 
color: orange; 
font-size: 25px; 
margin-right: 8px; 
} 

/* PLUS SIGN */ 
.sidebar ul li.has-plus::after { 
content: '+'; 
margin-left: auto; 
color: black; 
} 

/* CONTENT AREA */ 
.content { 
flex: 1; 
padding: 25px 30px;
background: #010839; 
position: relative;
} 

.content h2 { 
font-size: 25px; 
font-weight: 700; 
color: white; 
margin: 0 0 15px; 
text-transform: uppercase; 
letter-spacing: 1px; 
} 



/* FEATURED PRODUCTS */ 
/* ORANGLE LINE */
.content::after {
    content: "";
    position: absolute;
    top: 0;
    right: 40px;
    width: 1px;
    height: 100%;
    background: orange;
}

/* WHITE line */
.content::before {
    content: "";
    position: absolute;
    top: 0;
    right: 70px; 
    width: 1px;
    height: 100%;
    background: white;
}
